# Cloudinary server credentials. Never expose the API secret with NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# At least 32 random characters, used to sign the reviewer-session cookie.
DEMO_SESSION_SECRET=

# The demo fails closed when either analysis is disabled or unavailable.
CLOUDINARY_OCR_MODE=adv_ocr
CLOUDINARY_MODERATION_KIND=aws_rek

# Used for canonical and structured-data URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
